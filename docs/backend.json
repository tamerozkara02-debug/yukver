
{
  "entities": {
    "Admin": {
      "title": "Admin User",
      "description": "Represents a user with administrative privileges.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "profilePicture": { "type": "string", "format": "uri" },
        "permissions": {
            "type": "object",
            "properties": {
                "canViewDashboard": { "type": "boolean" },
                "canTrackLocations": { "type": "boolean" },
                "canManageMembers": { "type": "boolean" },
                "canManageStaff": { "type": "boolean" }
            }
        }
      },
      "required": ["id", "username", "permissions"]
    },
    "Firm": {
        "title": "Firm",
        "description": "Represents a company that provides loads.",
        "type": "object",
        "properties": {
            "id": { "type": "string" },
            "firstName": { "type": "string" },
            "lastName": { "type": "string" },
            "phoneNumber": { "type": "string" },
            "city": { "type": "string" },
            "district": { "type": "string" },
            "profilePicture": { "type": "string", "format": "uri" },
            "taxOffice": { "type": "string" },
            "taxNumber": { "type": "string" },
            "claimedByStaffId": { "type": "string" },
            "claimedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "firstName", "lastName", "phoneNumber", "city", "district"]
    },
    "Driver": {
        "title": "Driver",
        "description": "Represents a driver who can take loads.",
        "type": "object",
        "properties": {
            "id": { "type": "string" },
            "firstName": { "type": "string" },
            "lastName": { "type": "string" },
            "phoneNumber": { "type": "string" },
            "vehicleType": { "type": "string" },
            "vehiclePlate": { "type": "string" },
            "profilePicture": { "type": "string", "format": "uri" },
            "vehiclePicture": { "type": "string", "format": "uri" },
            "currentCity": { "type": "string" },
            "isAvailable": { "type": "boolean" },
            "latitude": { "type": "number" },
            "longitude": { "type": "number" },
            "lastLocationUpdate": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "firstName", "lastName", "phoneNumber", "vehicleType", "vehiclePlate"]
    },
    "Load": {
        "title": "Load",
        "description": "Represents a load to be transported.",
        "type": "object",
        "properties": {
            "firmId": { "type": "string" },
            "loadType": { "type": "string" },
            "tonnage": { "type": "number" },
            "originCity": { "type": "string" },
            "originDistrict": { "type": "string" },
            "destinationCity": { "type": "string" },
            "destinationDistrict": { "type": "string" },
            "requiredVehicleType": { "type": "string" },
            "notes": { "type": "string" },
            "createdAt": { "type": "string", "format": "date-time" },
            "claimedByStaffId": { "type": "string" },
            "claimedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["firmId", "loadType", "tonnage", "originCity", "originDistrict", "destinationCity", "destinationDistrict", "requiredVehicleType"]
    },
    "PublicShipment": {
      "title": "Public Shipment Tracking",
      "description": "Non-sensitive tracking information accessible via tracking number.",
      "type": "object",
      "properties": {
        "trackingNo": { "type": "string" },
        "status": { "type": "string", "enum": ["created", "picked_up", "in_transit", "out_for_delivery", "delivered", "canceled"] },
        "publicStatusText": { "type": "string" },
        "publicLastSeenArea": { "type": "string" },
        "eta": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "active": { "type": "boolean" }
      },
      "required": ["trackingNo", "status", "publicStatusText", "updatedAt", "active"]
    },
    "Review": {
      "title": "Review",
      "description": "Represents a review from one user to another.",
      "type": "object",
      "properties": {
        "reviewerId": { "type": "string" },
        "reviewerRole": { "type": "string", "enum": ["firma", "sofor", "admin"] },
        "revieweeId": { "type": "string" },
        "revieweeRole": { "type": "string", "enum": ["firma", "sofor"] },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reviewerId", "reviewerRole", "revieweeId", "revieweeRole", "rating", "comment", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Represents a direct message between two users.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "participantIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["senderId", "receiverId", "content", "createdAt", "participantIds"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous", "google.com"]
  },
  "firestore": {
    "structure": [
        { "path": "/firms/{firmId}", "schema": { "$ref": "#/entities/Firm" }, "description": "Stores company profiles." },
        { "path": "/firms/{firmId}/loads/{loadId}", "schema": { "$ref": "#/entities/Load" }, "description": "Stores loads for each company." },
        { "path": "/drivers/{driverId}", "schema": { "$ref": "#/entities/Driver" }, "description": "Stores driver profiles." },
        { "path": "/roles_admin/{userId}", "schema": { "$ref": "#/entities/Admin" }, "description": "Stores documents for users with admin roles." },
        { "path": "/publicShipments/{trackingNo}", "schema": { "$ref": "#/entities/PublicShipment" }, "description": "Public tracking records." },
        { "path": "/reviews/{reviewId}", "schema": { "$ref": "#/entities/Review" }, "description": "Stores all reviews between users." },
        { "path": "/messages/{messageId}", "schema": { "$ref": "#/entities/Message" }, "description": "Stores all direct messages between users." }
    ]
  }
}
