
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    //-//////////////////////////////////////////////////
    // Helper Functions
    //-//////////////////////////////////////////////////
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function userIsAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function getAdminPermissions() {
      return get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.permissions;
    }

    //-//////////////////////////////////////////////////
    // Collection Rules
    //-//////////////////////////////////////////////////

    // FIRMS: Public read, only owner or an admin with permissions can write/update.
    match /firms/{firmId} {
      allow get, list: if request.auth != null;
      allow create: if isOwner(firmId);
      allow update: if isOwner(firmId) || (userIsAdmin() && getAdminPermissions().canManageMembers == true);
      allow delete: if userIsAdmin() && getAdminPermissions().canManageMembers == true;
      
      // LOADS: Owners can manage their own loads. Admins can also manage them.
      match /loads/{loadId} {
        allow read: if request.auth != null;
        allow create: if isOwner(firmId);
        allow update: if isOwner(firmId) || userIsAdmin(); // Any admin can update (e.g., to claim)
        allow delete: if isOwner(firmId) || (userIsAdmin() && getAdminPermissions().canManageMembers == true);
      }
    }
    
    // DRIVERS: Public read, only owner can write/update their own document
    match /drivers/{driverId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      allow create: if isOwner(driverId);
      allow update: if isOwner(driverId);
      allow delete: if userIsAdmin() && getAdminPermissions().canManageMembers == true;
    }
    
    // Allow admins to list all loads via a collection group query for the 'ilanlar' page.
    match /{path=**}/loads/{loadId} {
      allow read: if userIsAdmin();
    }
    
    // REVIEWS: Authenticated users can create reviews.
    // Only admins can read, update, or delete them, as they are for internal purposes.
    match /reviews/{reviewId} {
      allow create: if request.auth != null;
      allow read, update, delete: if userIsAdmin();
    }

    // MESSAGES: Users can create messages. They can read specific messages they are part of.
    match /messages/{messageId} {
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid && request.auth.uid in request.resource.data.participantIds;
      allow get: if request.auth != null && request.auth.uid in resource.data.participantIds;
      // Admins can list messages they are a part of.
      allow list: if request.auth != null && request.auth.uid == request.query.where[0][2];
      allow update, delete: if false;
    }

    // ROLES_ADMIN: Users can read their own admin status. An admin with canManageStaff can manage roles.
    match /roles_admin/{userId} {
        allow get: if isOwner(userId) || userIsAdmin();
        allow list: if userIsAdmin();
        // Special case: allow the super admin email to bootstrap the first admin document (v73 trigger)
        allow create: if (userIsAdmin() && getAdminPermissions().canManageStaff == true) || (request.auth.token.email == 'tamerozkara02@gmail.com' && isOwner(userId));
        allow update: if isOwner(userId) || (userIsAdmin() && getAdminPermissions().canManageStaff == true);
        allow delete: if userIsAdmin() && getAdminPermissions().canManageStaff == true;
    }
    
    // Default rule: Deny all reads and writes by default (v73 trigger).
    // match /{document=**} {
    //   allow read, write: if false;
    // }
  }
}
