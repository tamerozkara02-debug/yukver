
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function userIsAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function getAdminPermissions() {
      return get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.permissions;
    }

    /**
     * PUBLIC SHIPMENTS: Takip sistemi.
     * Kullanıcıların direkt Firestore üzerinden okumasını kapatıyoruz.
     * Sadece sunucu tarafındaki API (Admin SDK) erişebilecek.
     */
    match /publicShipments/{trackingNo} {
      allow read: if false;
      allow write: if userIsAdmin();
    }

    /**
     * SHIPMENT CONTACTS: Hassas veriler.
     * Tamamen kapalı.
     */
    match /shipmentContacts/{trackingNo} {
      allow read, write: if false;
    }

    /**
     * SMS LOGS: Tamamen kapalı.
     */
    match /smsLogs/{logId} {
      allow read, write: if false;
    }

    match /firms/{firmId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(firmId);
      allow update: if isOwner(firmId) || (userIsAdmin() && getAdminPermissions().canManageMembers == true);
      allow delete: if userIsAdmin() && getAdminPermissions().canManageMembers == true;
      
      match /loads/{loadId} {
        allow read: if isSignedIn();
        allow create: if isOwner(firmId);
        allow update: if isOwner(firmId) || userIsAdmin();
        allow delete: if isOwner(firmId) || (userIsAdmin() && getAdminPermissions().canManageMembers == true);
      }
    }
    
    match /drivers/{driverId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(driverId);
      allow update: if isOwner(driverId);
      allow delete: if userIsAdmin() && getAdminPermissions().canManageMembers == true;
    }
    
    match /{path=**}/loads/{loadId} {
      allow read: if userIsAdmin();
    }
    
    match /reviews/{reviewId} {
      allow create: if isSignedIn();
      allow read, update, delete: if userIsAdmin();
    }

    match /messages/{messageId} {
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid && request.auth.uid in request.resource.data.participantIds;
      allow get: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow list: if isSignedIn() && request.auth.uid == request.query.where[0][2];
      allow update, delete: if false;
    }

    match /roles_admin/{userId} {
        // Kullanıcının kendi rolünü okumasına izin ver (Önemli: isOwner kontrolü başa alındı)
        allow get: if isOwner(userId) || userIsAdmin();
        allow list: if userIsAdmin();
        allow create: if (userIsAdmin() && getAdminPermissions().canManageStaff == true) || (request.auth.token.email == 'tamerozkara02@gmail.com' && isOwner(userId));
        allow update: if isOwner(userId) || (userIsAdmin() && getAdminPermissions().canManageStaff == true);
        allow delete: if userIsAdmin() && getAdminPermissions().canManageStaff == true;
    }
  }
}
