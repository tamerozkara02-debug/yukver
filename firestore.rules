rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    //-//////////////////////////////////////////////////
    // Helper Functions
    //-//////////////////////////////////////////////////
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function userIsAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function getAdminPermissions() {
      return get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.permissions;
    }

    //-//////////////////////////////////////////////////
    // Collection Rules
    //-//////////////////////////////////////////////////

    // FIRMS: Public read, only owner can write/update their own document
    match /firms/{firmId} {
      allow get, list: if request.auth != null;
      allow create: if isOwner(firmId);
      allow update: if isOwner(firmId);
      allow delete: if userIsAdmin() && getAdminPermissions().canManageMembers == true;
      
      // LOADS: Owners can manage their own loads, admins can delete them.
      match /loads/{loadId} {
        allow read, create, update: if isOwner(firmId);
        allow delete: if isOwner(firmId) || (userIsAdmin() && getAdminPermissions().canManageMembers == true);
      }
    }
    
    // DRIVERS: Public read, only owner can write/update their own document
    match /drivers/{driverId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null; // Changed to allow any authenticated user to list drivers.
      allow create: if isOwner(driverId);
      allow update: if isOwner(driverId);
      allow delete: if userIsAdmin() && getAdminPermissions().canManageMembers == true;
    }
    
    // REVIEWS: Authenticated users can create reviews.
    // Only admins can read, update, or delete them, as they are for internal purposes.
    match /reviews/{reviewId} {
      allow create: if request.auth != null;
      allow read, update, delete: if userIsAdmin();
    }

    // ROLES_ADMIN: Users can read their own admin status. Any authenticated user can see the list of admins.
    // Backend flows handle creation/deletion, but this rule provides an extra layer of security.
    match /roles_admin/{userId} {
        allow get: if isOwner(userId);
        allow list: if request.auth != null;
        allow create, delete: if userIsAdmin() && getAdminPermissions().canManageStaff == true;
    }
    
    // Default rule: Deny all reads and writes by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
