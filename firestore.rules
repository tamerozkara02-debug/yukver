rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    //-//////////////////////////////////////////////////
    // Helper Functions
    //-//////////////////////////////////////////////////
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    //-//////////////////////////////////////////////////
    // Collection Rules
    //-//////////////////////////////////////////////////

    // FIRMS: Public read, only owner can write/update their own document
    match /firms/{firmId} {
      allow get, list: if request.auth != null;
      allow create: if isOwner(firmId);
      allow update: if isOwner(firmId);
      allow delete: if isAdmin();
      
      // LOADS: Owners can manage their own loads, admins can delete them.
      match /loads/{loadId} {
        allow read, create, update: if isOwner(firmId);
        allow delete: if isOwner(firmId) || isAdmin();
      }
    }
    
    // DRIVERS: Public read, only owner can write/update their own document
    match /drivers/{driverId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null; // Changed to allow any authenticated user to list drivers.
      allow create: if isOwner(driverId);
      allow update: if isOwner(driverId);
      allow delete: if isAdmin();
    }
    
    // REVIEWS: Authenticated users can create reviews.
    // Only admins can read, update, or delete them, as they are for internal purposes.
    match /reviews/{reviewId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // ROLES_ADMIN: Only other admins can read or write to this collection
    match /roles_admin/{userId} {
        allow get, list, create, delete: if isAdmin();
    }
    
    // Default rule: Deny all reads and writes by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
