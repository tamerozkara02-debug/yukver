rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PROTOTYPE MODE: YUKVER.NET TRACKING MODULE SECURITY RULES
     * 
     * CORE PHILOSOPHY: 
     * This ruleset implements a "Strict Server-Side Mediation" model. To maximize security 
     * for sensitive logistics data (like phone numbers and tracking movement), direct 
     * client-side access to Firestore is disabled for all module collections. 
     *
     * DATA STRUCTURE:
     * - /publicShipments/{trackingNo}: Publicly viewable tracking info (status, ETA).
     * - /shipmentContacts/{trackingNo}: Private contact info (phone, preferences).
     * - /smsLogs/{smsLogId}: Internal system logs for audit trails.
     *
     * KEY SECURITY DECISIONS:
     * 1. API-ONLY ACCESS: As specified in the architectural reasoning, all tracking queries 
     *    and shipment updates must be performed via server-side environments (Next.js API 
     *    Routes or Cloud Functions) using the Firebase Admin SDK.
     * 2. STRUCTURAL SEGREGATION: Sensitive data (contacts) is stored in a completely 
     *    separate collection from public data to prevent accidental leakage through rules 
     *    misconfiguration.
     * 3. DENIAL BY DEFAULT: All client-side write and read operations are explicitly denied 
     *    to ensure no data is exposed to unauthorized browsers or malicious scripts.
     * 4. RELATIONAL INTEGRITY: Since all operations are server-side, relational validation 
     *    (matching trackingNo across collections) is handled by the application logic 
     *    rather than security rules.
     */

    // The helper functions (isSignedIn, isOwner, isExistingOwner) were removed.
    // They were identified as unused because all client-side operations are
    // explicitly denied (`allow ...: if false;`) per the "API-ONLY ACCESS"
    // and "DENIAL BY DEFAULT" security decisions. These helpers would only
    // be relevant if client-side access was permitted under specific
    // authentication or authorization conditions.

    /**
     * @description Public tracking information. Read access is denied here because 
     *              retrieval is handled via a secure server-side API to control data exposure.
     * @path /publicShipments/{trackingNo}
     * @allow None (Access restricted to Admin SDK).
     * @deny (get) Any direct client-side fetch attempt.
     * @principle API Mediation: Forces all requests through a controlled backend layer.
     */
    match /publicShipments/{trackingNo} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }

    /**
     * @description Private contact details and SMS preferences. This collection 
     *              contains PII (Phone numbers) and is strictly forbidden for client access.
     * @path /shipmentContacts/{trackingNo}
     * @allow None (Access restricted to Admin SDK/Cloud Functions).
     * @deny (list) Unauthorized listing of recipient phone numbers.
     * @principle PII Protection: Absolute isolation of sensitive contact data from the client.
     */
    match /shipmentContacts/{trackingNo} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }

    /**
     * @description Internal logs for SMS notification attempts. 
     * @path /smsLogs/{smsLogId}
     * @allow None (System-only logging).
     * @deny (create) Client-side attempts to spoof or manipulate logs.
     * @principle Audit Integrity: Prevents clients from viewing or modifying system audit trails.
     */
    match /smsLogs/{smsLogId} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }

    // Default deny for any unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}