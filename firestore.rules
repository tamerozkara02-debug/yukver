
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    //-//////////////////////////////////////////////////
    // Helper Functions
    //-//////////////////////////////////////////////////
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function userIsAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function getAdminPermissions() {
      return get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.permissions;
    }

    //-//////////////////////////////////////////////////
    // Collection Rules
    //-//////////////////////////////////////////////////

    // ROLES_ADMIN: Personel yetki kontrolü
    match /roles_admin/{userId} {
      // Herkes SADECE kendi personel dokümanını okuyabilir (admin olup olmadığını anlamak için)
      allow get: if request.auth != null && request.auth.uid == userId;

      // Sadece personel yönetme yetkisi olan adminler listeleme yapabilir
      allow list: if request.auth != null 
        && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.permissions.canManageStaff == true;

      // CREATE Kuralları:
      // 1. Super Admin (tamerozkara02@gmail.com) SADECE kendi UID'si için doküman oluşturabilir (Bootstrap)
      // 2. canManageStaff yetkisi olan adminler diğer personel dokümanlarını oluşturabilir
      allow create: if request.auth != null && (
        (request.auth.uid == userId && request.auth.token.email == 'tamerozkara02@gmail.com')
        ||
        (exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.permissions.canManageStaff == true)
      );

      // UPDATE/DELETE Kuralları:
      // Sadece canManageStaff yetkisi olan adminler işlem yapabilir. 
      // Kendi dokümanını güncelleme yetkisi kapatıldı (yetki yükseltme açığı için).
      allow update, delete: if request.auth != null 
        && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.permissions.canManageStaff == true;
    }

    // FIRMS: Kamu okuma, sadece sahip veya yetkili admin yazabilir.
    match /firms/{firmId} {
      allow get, list: if request.auth != null;
      allow create: if isOwner(firmId);
      allow update: if isOwner(firmId) || (userIsAdmin() && getAdminPermissions().canManageMembers == true);
      allow delete: if userIsAdmin() && getAdminPermissions().canManageMembers == true;
      
      match /loads/{loadId} {
        allow read: if request.auth != null;
        allow create: if isOwner(firmId);
        allow update: if isOwner(firmId) || userIsAdmin();
        allow delete: if isOwner(firmId) || (userIsAdmin() && getAdminPermissions().canManageMembers == true);
      }
    }
    
    // DRIVERS: Kamu okuma, sadece sahip veya yetkili admin silebilir.
    match /drivers/{driverId} {
      allow get, list: if request.auth != null;
      allow create: if isOwner(driverId);
      allow update: if isOwner(driverId);
      allow delete: if userIsAdmin() && getAdminPermissions().canManageMembers == true;
    }
    
    // Koleksiyon grubu sorguları için
    match /{path=**}/loads/{loadId} {
      allow read: if userIsAdmin();
    }
    
    match /reviews/{reviewId} {
      allow create: if request.auth != null;
      allow read, update, delete: if userIsAdmin();
    }

    match /messages/{messageId} {
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid && request.auth.uid in request.resource.data.participantIds;
      allow get: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow list: if request.auth != null && request.auth.uid == request.query.where[0][2];
      allow update, delete: if false;
    }
  }
}
